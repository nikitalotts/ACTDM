# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- артефакты обучения ---
checkpoints/
generated_texts/
datasets/
wandb/
*.pth
*.pt
*.bin
*.safetensors
*.ckpt

# --- вывод SLURM: только в корне, чтобы не задеть logs/ с логами экспериментов ---
/*.log
/*.err
/*.out
/slurm-*
slurm_logs/*
!slurm_logs/.gitkeep

# --- результаты диагностик (probe_*.py) ---
# Крупные дампы не храним, но ИТОГОВЫЕ json и логи, из которых взяты числа
# статьи, обязаны лежать в репозитории: аргумент «пересчитывается из
# чекпоинтов» не работает, когда ни чекпоинтов, ни квоты на прогон уже нет.
probe_results/*
!probe_results/*.json
!probe_results/.gitkeep
image_latents.npy

# --- артефакты, на которые ссылается статья: отслеживаются всегда ---
!results/
!results/**

# --- кеши ---
.cache/
nltk_data/

# --- IDE и ОС ---
.idea/
.vscode/
.DS_Store
Thumbs.db
